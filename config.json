  "script": "<script src='https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js'></script><script src='https://blog.meekdai.com/Gmeek/plugins/lightbox.js'></script><style>#reading-progress{position:fixed;right:20px;bottom:20px;width:48px;height:48px;z-index:9999;cursor:pointer;opacity:0;transition:opacity .3s;}#reading-progress.show{opacity:1;}#reading-progress circle{fill:none;stroke-width:4;}#reading-progress .rp-bg{stroke:var(--color-border-muted,#d0d7de);opacity:.4;}#reading-progress .rp-fg{stroke:var(--color-accent-emphasis,#0969da);stroke-linecap:round;transform:rotate(-90deg);transform-origin:50% 50%;transition:stroke-dashoffset .15s;}#rp-text{position:fixed;right:20px;bottom:20px;width:48px;height:48px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:var(--color-fg-muted,#57606a);pointer-events:none;z-index:10000;}</style><script>(function(){if(!document.getElementById('postBody'))return;var svgNS='http://www.w3.org/2000/svg';var svg=document.createElementNS(svgNS,'svg');svg.id='reading-progress';svg.setAttribute('viewBox','0 0 48 48');var bg=document.createElementNS(svgNS,'circle');bg.setAttribute('class','rp-bg');bg.setAttribute('cx','24');bg.setAttribute('cy','24');bg.setAttribute('r','20');var fg=document.createElementNS(svgNS,'circle');fg.setAttribute('class','rp-fg');fg.setAttribute('cx','24');fg.setAttribute('cy','24');fg.setAttribute('r','20');var r=20,C=2*Math.PI*r;fg.setAttribute('stroke-dasharray',C);fg.setAttribute('stroke-dashoffset',C);svg.appendChild(bg);svg.appendChild(fg);document.body.appendChild(svg);var txt=document.createElement('div');txt.id='rp-text';document.body.appendChild(txt);var timer;function update(){var st=document.documentElement.scrollTop||document.body.scrollTop;var sh=(document.documentElement.scrollHeight||document.body.scrollHeight)-window.innerHeight;var p=sh>0?Math.min(st/sh,1):0;fg.setAttribute('stroke-dashoffset',C*(1-p));txt.textContent=Math.round(p*100)+'%';if(st>200){svg.classList.add('show');}else{svg.classList.remove('show');}}window.addEventListener('scroll',function(){clearTimeout(timer);timer=setTimeout(update,30);});svg.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});update();})();</script>"
